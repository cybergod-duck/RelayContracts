{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "hardhat"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["scripts/**/*", "hardhat.config.ts", "contracts/**/*"],
  "exclude": ["node_modules", "e_knowledge", "a_skills", "b_initiate"]
}
